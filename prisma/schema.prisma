generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Practice {
  id               String            @id @default(cuid())
  name             String
  createdAt        DateTime          @default(now())
  users            User[]
  patients         Patient[]
  reports          Report[]
  serviceCatalog   ServiceCatalogItem[]
  serviceTemplates ServiceTemplate[]

  // Punktwerte zur Berechnung geschätzter Rechnungsbeträge (Punktzahl ×
  // Punktwert × Faktor). In Cent, mit Nachkommastellen, da die amtlichen
  // Punktwerte selbst Bruchteile eines Cents sind. GOZ ist bundeseinheitlich
  // gesetzlich fixiert (aktuell 5,62421 Cent) und wird bei Neuanlage einer
  // Praxis vorbelegt; BEMA verhandelt jede KZV regional mit den
  // Krankenkassen ihres Bundeslands, es gibt keinen bundeseinheitlichen
  // Wert - die Praxis muss ihn selbst eintragen.
  gozPunktwertCent  Float?
  bemaPunktwertCent Float?
  invites           StaffInvite[]
  proposals         TreatmentProposal[]
  connectorKeys     ConnectorKey[]
  launchTokens      LaunchToken[]
  anamnesisForms    AnamnesisForm[]
  invoices          Invoice[]
  locations         Location[]
  appointments      Appointment[]
  /// Bankverbindung für den GiroCode im Patientenportal (lib/invoices.ts)
  accountHolder     String?
  iban              String?
  bic               String?
  /// Gläubiger-Identifikationsnummer (Bundesbank) für SEPA-Lastschriften
  glaeubigerId      String?
  // Praxiseigene Preise für Behandlungsvorschläge (Euro je Preisschlüssel
  // aus lib/proposals.ts PRICE_DEFS). Null bzw. fehlende Schlüssel = die
  // dort hinterlegten Beispielwerte.
  proposalPrices    Json?
  /// Ratenzahlung im Patienten-Link (lib/installments.ts)
  installments      Json?
  /// Fachgebiet (lib/specialties.ts): "zahn", "augen", "haut", … oder "andere"
  specialty         String            @default("zahn")
  /// Arztpraxen: Preise je Leistung und eigene Leistungen (lib/medicalProposals.ts)
  medPrices         Json?
  customOffers      Json?
  // Gastzugang: Demo-Praxis mit Beispieldaten, die nach Ablauf automatisch
  // gelöscht wird (lib/demo.ts).
  isDemo            Boolean           @default(false)
  /// Zwei-Faktor-Anmeldung auch für Mitarbeitende verlangen (für Admins immer Pflicht)
  require2faAll     Boolean           @default(false)
  demoExpiresAt     DateTime?

  @@index([isDemo, demoExpiresAt])
}

// Partner-Zugang für Drittsysteme (andere Praxisverwaltungssysteme), die
// unsere Validierungs-/KI-Berichts-Engine per API einbinden, statt unsere
// komplette App zu nutzen. Bewusst zustandslos gegenüber Patientendaten des
// Partners - wir persistieren dessen Patienten-/Behandlungsdaten nicht,
// nur Metadaten zum API-Client selbst.
model ApiClient {
  id           String    @id @default(cuid())
  name         String // Partnername, z. B. "Charly PVS Systems GmbH"
  apiKeyHash   String    @unique
  apiKeyPrefix String // erste Zeichen des Keys zur Anzeige/Identifikation, ohne den vollen Key zu speichern
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("staff") // "admin" | "staff"
  /// Analyse (/analyse) für Mitarbeitende freigegeben; Admins (Geschäftsführung) sehen sie immer
  canSeeAnalytics Boolean @default(false)
  practiceId   String
  practice     Practice @relation(fields: [practiceId], references: [id])
  reports      Report[]
  proposals    TreatmentProposal[]
  /// Patienten, für die dieses Konto Stammbehandler/in ist (Seite "Mein Bereich")
  stammPatienten Patient[] @relation("Stammbehandler")
  // TOTP-Zweitfaktor (RFC 6238). totpSecret wird beim Einrichten gesetzt,
  // aber erst nach erfolgreicher Verifikation ist totpEnabled=true und der
  // Login verlangt zusätzlich zum Passwort einen gültigen Code.
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  // Gehashte Einmal-Backup-Codes für den Fall, dass der Zugriff auf die
  // Authenticator-App verloren geht. Comma-separated bcrypt-Hashes; ein
  // Code wird beim Verbrauch aus der Liste entfernt.
  totpBackupCodes String?
  reportRevisions ReportRevision[]
  resetTokens     PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  // Nicht blockierend: unverifizierte Konten können sich weiterhin anmelden
  // und die App nutzen (kein zusätzliches Hindernis im Praxisalltag), sehen
  // aber einen Hinweis, bis die Adresse bestätigt wurde.
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
}

// Einmal-Token zur Bestätigung der E-Mail-Adresse nach der Registrierung.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Einmal-Token für den Passwort-Reset-Flow. tokenHash statt Klartext, damit
// ein DB-Leak keine gültigen Reset-Links preisgibt. Läuft nach kurzer Zeit
// ab und wird nach Verwendung markiert, damit derselbe Link nicht zweimal
// nutzbar ist.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Einladung eines weiteren Praxismitglieds. tokenHash statt Klartext wie
// beim Passwort-Reset. Erst nach Einlösen (Name+Passwort setzen) entsteht
// ein echter User-Datensatz - vorher existiert die eingeladene Person noch
// nicht als Login.
model StaffInvite {
  id         String    @id @default(cuid())
  practiceId String
  practice   Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  email      String
  role       String    @default("staff") // "admin" | "staff"
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([practiceId])
}

model Patient {
  id              String   @id @default(cuid())
  practiceId      String
  practice        Practice @relation(fields: [practiceId], references: [id])
  firstName       String
  lastName        String
  birthDate       DateTime?
  /// "W" | "M" | "D" (divers); steuert geschlechtsbezogene Angebote und Befunde
  geschlecht      String?
  /// Stammbehandler/in (meist Ärztin oder Arzt); bestimmt, wessen "Mein Bereich" den Patienten zeigt
  behandlerId     String?
  behandler       User?    @relation("Stammbehandler", fields: [behandlerId], references: [id], onDelete: SetNull)
  // "GKV" (gesetzlich) | "PKV" (privat) - bestimmt, welches Gebührenwerk
  // (BEMA vs. GOZ/GOÄ) für diesen Patienten grundsätzlich greift.
  insuranceType   String?
  insuranceName   String?
  insuranceNumber String?
  /// Kontakt für Terminbestätigungen, Erinnerungen und Zahlungserinnerungen
  email           String?
  phone           String?
  /// Einwilligung in Nachrichten per E-Mail (Zeitpunkt, null = keine)
  contactConsentAt DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  reports         Report[]
  proposals       TreatmentProposal[]
  launchTokens    LaunchToken[]
  anamnesisForms  AnamnesisForm[]
  invoices        Invoice[]
  entries         PatientEntry[]
  documents       PatientDocument[]
  appointments    Appointment[]
  // Patientenportal (/portal/<token>): offene Rechnungen und Dokumente auf
  // dem eigenen Handy. Gespeichert wird nur der Hash des Tokens.
  portalTokenHash String?   @unique
  portalExpiresAt DateTime?
  portalViewedAt  DateTime?
  /// Zuletzt an Vorsorge erinnert (Seite /vorsorge)
  recallSentAt    DateTime?
  // Herkunft aus einer Praxissoftware (VDDS-media): Sektionsname der PVS
  // (z. B. "DSWIN", "Z1") und deren Patientennummer (PATID). Gemeinsam
  // eindeutig je Praxis, damit derselbe PVS-Patient beim nächsten Aufruf
  // wiedergefunden statt doppelt angelegt wird.
  externalSource  String?
  externalId      String?

  @@unique([practiceId, externalSource, externalId])
  @@index([practiceId])
  @@index([behandlerId])
}

// SQLite has no native enum support; these are constrained to
// "BEFUND" | "KRANKENKASSE" and "ENTWURF" | "FINAL" in application code.
model Report {
  id                String            @id @default(cuid())
  practiceId        String
  practice          Practice          @relation(fields: [practiceId], references: [id])
  patientId         String
  patient           Patient           @relation(fields: [patientId], references: [id])
  authorId          String
  author            User              @relation(fields: [authorId], references: [id])
  type              String
  status            String            @default("ENTWURF")
  treatmentDate     DateTime?
  serviceTemplateId String?
  serviceTemplate   ServiceTemplate?  @relation(fields: [serviceTemplateId], references: [id])
  serviceEntries    ReportServiceEntry[]
  // Server-generated summary of the reviewed service list, used as the
  // structured basis for the AI report text (replaces free-text input).
  serviceSummary    String
  // Set once staff has explicitly confirmed the full checklist was reviewed
  // (nothing left unreviewed) before generation is allowed.
  reviewConfirmed   Boolean           @default(false)
  additionalContext String?
  generatedText     String?
  editedText        String?
  // Freigabe: wer den Bericht als fertig markiert hat und wann. Wird bei
  // jeder späteren Textänderung zurückgesetzt (Bericht ist dann wieder Entwurf).
  approvedById      String?
  approvedByName    String?
  approvedAt        DateTime?
  revisions         ReportRevision[]
  proposals         TreatmentProposal[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([practiceId])
  @@index([patientId])
}

// Snapshot des Berichtstexts, bevor er durch eine Bearbeitung überschrieben
// wird - macht Änderungen an der Gesundheitsdokumentation nachvollziehbar,
// statt sie kommentarlos zu überschreiben.
model ReportRevision {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  text       String
  editedById String
  editedBy   User     @relation(fields: [editedById], references: [id])
  createdAt  DateTime @default(now())

  @@index([reportId])
}

// Beispielkatalog von Leistungspositionen (GOZ/BEMA/GOÄ/BEL II). Enthält
// bewusst keine Punktzahlen/Punktwerte/Festbeträge (Cent-Beträge), da sich
// diese ändern und praxis-/kassenspezifisch sind - diese Felder existieren
// im Schema, sind im Beispielkatalog aber unbefüllt (null) und müssen von
// der Praxis gegen das aktuelle offizielle Gebührenverzeichnis eingetragen
// werden. practiceId = null bedeutet: globale Standardposition, für alle
// Praxen sichtbar; gesetzt = praxiseigene Zusatzposition.
model ServiceCatalogItem {
  id           String              @id @default(cuid())
  /// Fach der globalen Position; eigene Positionen der Praxis haben keins
  fach         String?
  practiceId   String?
  practice     Practice?           @relation(fields: [practiceId], references: [id])
  system       String // "GOZ" | "BEMA" | "GOAE" | "BEL_II" | "SONSTIGES"
  code         String
  title        String
  description  String?
  category     String
  // Ob "Zahn/Region" bei dieser Position sinnvoll abfragbar ist (z. B. bei
  // einer Füllung ja, bei "Eingehende Untersuchung" nein). Steuert nur, ob
  // das Feld standardmäßig ein- oder ausgeblendet ist - es lässt sich in
  // der Erfassung immer manuell einblenden.
  toothRelevant Boolean            @default(true)

  // Abrechnungsdetails - bewusst optional/unbefüllt im Beispielkatalog
  // (siehe Kommentar oben), aber vom Modell her vorgesehen. Der Punktwert
  // (Cent pro Punkt) steht bewusst NICHT hier, sondern auf Practice, da er
  // system-/regionweit gilt und nicht je Katalogposition unterschiedlich
  // ist - siehe Practice.gozPunktwertCent/bemaPunktwertCent.
  punktzahl                   Float?    // GOZ/GOÄ/BEMA, amtliche Punktzahl der Ziffer
  festbetragCent                Int?    // BEMA/BEL II Festbetrag in Cent (Pauschale statt Punktzahl×Punktwert)
  faktorMin                     Float?  // GOZ/GOÄ, i. d. R. 1.0
  faktorMax                     Float?  // GOZ/GOÄ, i. d. R. 3.5
  regelhoechstfaktor            Float?  // GOZ i. d. R. 2.3
  begruendungspflichtAbFaktor   Float?  // ab diesem Faktor ist eine schriftliche Begründung Pflicht (§5 GOZ)
  // Comma-separated catalogItemIds nicht gleichzeitig abrechenbarer
  // Positionen (z. B. zwei verschiedene Füllungsarten am selben Zahn).
  ausschlussMit                 String?
  frequenzlimitAnzahl           Int?    // z. B. 2x
  frequenzlimitZeitraumTage     Int?    // z. B. je 365 Tage
  gueltigAb                     DateTime?
  gueltigBis                    DateTime?

  createdAt    DateTime            @default(now())
  templateItems ServiceTemplateItem[]
  reportEntries ReportServiceEntry[]

  @@index([practiceId])
}

// Vorlage für einen Sitzungstyp (z. B. "Kontrolluntersuchung",
// "Füllungstherapie"), die eine feste Liste typischer Leistungspositionen
// vorgibt. Beim Anlegen eines Berichts sind alle Positionen einer Vorlage
// standardmäßig als erbracht markiert; nicht erbrachte Positionen müssen
// aktiv gestrichen werden (Opt-out statt Opt-in), damit nichts vergessen
// wird.
model ServiceTemplate {
  id          String                @id @default(cuid())
  /// Fach der globalen Vorlage (z. B. "zahn", "kardio"); eigene Vorlagen der Praxis haben keins
  fach        String?
  practiceId  String?
  practice    Practice?             @relation(fields: [practiceId], references: [id])
  name        String
  description String?
  createdAt   DateTime              @default(now())
  items       ServiceTemplateItem[]
  reports     Report[]

  @@index([practiceId])
}

model ServiceTemplateItem {
  id             String             @id @default(cuid())
  templateId     String
  template       ServiceTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  catalogItemId  String
  catalogItem    ServiceCatalogItem @relation(fields: [catalogItemId], references: [id])
  position       Int                @default(0)
  // Comma-separated catalogItemIds of OTHER items in the same template that
  // must be effectively performed for this item to be possible at all
  // (OR semantics — any one is enough). Lets a branch "aufeinander
  // aufbauen": striking a prerequisite auto-strikes and locks everything
  // that logically follows it. Null/empty = no dependency.
  dependsOn      String?

  @@unique([templateId, catalogItemId])
  @@index([templateId])
}

// Kontrollierte Erfassung je Bericht: eine Zeile pro Leistungsposition der
// verwendeten Vorlage, `performed` startet bei true (angehakt/erbracht) und
// wird von der Praxis aktiv auf false gesetzt (durchgestrichen), wenn der
// Arzt die Leistung nicht erbracht hat.
model ReportServiceEntry {
  id            String             @id @default(cuid())
  reportId      String
  report        Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   ServiceCatalogItem @relation(fields: [catalogItemId], references: [id])
  performed     Boolean            @default(true)
  toothNumbers  String?
  quantity      Int                @default(1)
  note          String?
  // Steigerungsfaktor bei GOZ/GOÄ-Positionen (i. d. R. 1.0-3.5).
  faktor        Float?
  // Schriftliche Begründung, Pflicht sobald faktor über dem
  // Regelhöchstfaktor/begruendungspflichtAbFaktor der Position liegt.
  begruendung   String?
  position      Int                @default(0)

  @@index([reportId])
}

// Rein informatives Nachschlagewerk zu gängigen Selbstzahlerleistungen
// (IGEL) je Behandlungskategorie - bewusst NICHT patientenbezogen und ohne
// jede Empfehlungs-/Vorschlagslogik. Zweck: der Praxis im
// Beratungsgespräch sachliche Hintergrundinfos an die Hand geben, welche
// Optionen über die Kassenleistung hinaus grundsätzlich existieren und wo
// deren Grenzen liegen - die fachliche Einschätzung im Einzelfall bleibt
// vollständig bei der behandelnden Person. Kein Bezug zu Report/Patient/
// ServiceCatalogItem, damit hieraus technisch kein "für Patient X
// vorgeschlagen"-Flow entstehen kann.
model LexikonEntry {
  id                  String   @id @default(cuid())
  category            String
  title               String
  // Sachliche, knappe Einordnung: was deckt die GKV hier typischerweise ab
  // bzw. wo liegen die üblichen Grenzen (Häufigkeit, Ausführung, Material).
  gkvEinordnung        String
  // Sachliche, knappe Beschreibung der Selbstzahler-Option und wann sie
  // in Betracht gezogen werden könnte - bewusst ohne Werbesprache.
  selbstzahlerOption   String
  position             Int      @default(0)

  @@index([category])
}

// Behandlungsvorschlag für einen Patienten: Befunde (Zahnschema + allgemeine
// Befunde + Patientenfaktoren) in `input`, gewählte Option je Befund in
// `choices`. Die Optionen selbst werden nicht gespeichert, sondern bei jeder
// Anzeige aus input + Preisliste neu berechnet (lib/proposals.ts). Die
// Cent-Summen und der Patiententext sind Schnappschüsse zum Zeitpunkt des
// Speicherns, damit Auswertung und Aufklärungsnachweis (§ 630c Abs. 3 BGB)
// stabil bleiben, auch wenn sich Preise später ändern.
model TreatmentProposal {
  id              String   @id @default(cuid())
  practiceId      String
  practice        Practice @relation(fields: [practiceId], references: [id])
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  // Gesetzt, wenn der Vorschlag im Abschluss-Schritt zusammen mit dem
  // Bericht derselben Behandlung entstanden ist.
  reportId        String?
  report          Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  // "ENTWURF" | "BESPROCHEN" | "ANGENOMMEN" | "ABGELEHNT"
  status          String   @default("ENTWURF")
  input           Json
  choices         Json
  baseTotalCent   Int
  planTotalCent   Int
  eigenanteilCent Int
  letterText      String
  // Patienten-Link: Der Patient sieht seinen Vorschlag auf dem eigenen
  // Gerät (/p/<token>) und meldet Interesse oder Rückrufwunsch zurück.
  // Gespeichert wird nur der Hash des Tokens.
  shareTokenHash     String?   @unique
  shareExpiresAt     DateTime?
  patientViewedAt    DateTime?
  // "INTERESSE" | "RUECKRUF"
  patientResponse    String?
  // Vom Patienten bevorzugte Option je Befund, z. B. {"t36":"impl"}
  patientChoices     Json?
  patientNote        String?
  patientRespondedAt DateTime?
  /// Erster Versand eines Patienten-Links (bleibt beim Sperren erhalten, für die Auswertung)
  shareCreatedAt     DateTime?
  patientWantsInstallments Boolean @default(false)
  /// Digitales Einverständnis im Patientenportal (Name, Unterschrift als PNG-Data-URL, Zeitpunkt)
  agreedAt        DateTime?
  agreedName      String?
  agreedSignature String?
  agreedChoices   Json?
  /// Erklärungstext, wie er beim Unterschreiben angezeigt wurde
  agreedText      String?
  invoices        Invoice[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([practiceId])
  @@index([patientId])
  @@index([reportId])
}

// Schlüssel, mit dem der Sorrida-Connector auf einem Praxis-PC Patienten aus
// der Praxissoftware an diese App übergibt. Nur der Hash wird gespeichert.
// Der Schlüssel darf ausschließlich Patienten anlegen/aktualisieren und
// Start-Tokens erzeugen - lesen kann er nichts.
model ConnectorKey {
  id         String    @id @default(cuid())
  practiceId String
  practice   Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([practiceId])
}

// Einmal-Token, mit dem das vom Connector geöffnete Fenster den Patienten
// lädt, ohne dass Patientendaten in der URL stehen. Kurzlebig und nur
// einmal einlösbar, und nur von einem angemeldeten Nutzer derselben Praxis.
model LaunchToken {
  id         String    @id @default(cuid())
  practiceId String
  practice   Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  view       String    @default("bericht")
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([practiceId])
}

// Anfrage über die öffentliche Website (Pilotplatz/Demo). Gehört zu keiner
// Praxis; nur der Betreiber sieht sie (E-Mail-Benachrichtigung, Datenbank).
model Lead {
  id           String   @id @default(cuid())
  practiceName String
  contactName  String
  dentists     String
  contact      String
  pvs          String?
  callbackTime String?
  specialty    String?
  /// "pilot" (Pilotplatz) | "hilfe" (Fachrichtung nicht gefunden, Support)
  kind         String   @default("pilot")
  message      String?
  /// Vom Sorrida-Team im Postfach (/anfragen) als erledigt markiert
  handledAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
}

/// Digitale Anamnese: Die Praxis schickt einen Link/QR-Code, der Patient
/// füllt den Bogen auf dem eigenen Gerät aus. Gespeichert wird nur der Hash
/// des Tokens. Fragen und Auswertung in lib/anamnesis.ts.
model AnamnesisForm {
  id          String    @id @default(cuid())
  practiceId  String
  practice    Practice  @relation(fields: [practiceId], references: [id])
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])
  tokenHash   String?   @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  viewedAt    DateTime?
  submittedAt DateTime?
  answers     Json?

  @@index([practiceId, patientId])
}

/// Rechnung an einen Patienten, z. B. der Eigenanteil eines angenommenen
/// Vorschlags. Der Patient sieht sie im Patientenportal und zahlt per
/// Überweisung (GiroCode). Status: "OFFEN" | "GEMELDET" (Patient hat
/// Zahlung gemeldet) | "BEZAHLT" | "STORNIERT". Logik in lib/invoices.ts.
model Invoice {
  id             String             @id @default(cuid())
  practiceId     String
  practice       Practice           @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  proposalId     String?
  proposal       TreatmentProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  number         String
  title          String
  amountCent     Int
  dueDate        DateTime
  status         String             @default("OFFEN")
  /// Patient möchte in Raten zahlen (Anfrage aus dem Portal)
  wantsInstallments Boolean         @default(false)
  reportedPaidAt DateTime?
  paidAt         DateTime?
  remindedAt     DateTime?
  /// Mahnstufe: 0 = noch nicht erinnert, 1 = Erinnerung, 2 = 2. Erinnerung, 3 = letzte Mahnung
  reminderLevel  Int                @default(0)
  /// SEPA-Lastschriftmandat aus dem Portal (Einzelmandat für diese Rechnung)
  sepaIban       String?
  sepaName       String?
  sepaMandatAt   DateTime?
  /// In eine pain.008-Datei übernommen (nicht doppelt einziehen)
  sepaExportedAt DateTime?
  createdAt      DateTime           @default(now())

  @@unique([practiceId, number])
  @@index([practiceId, status])
  @@index([patientId])
}

// Protokoll sicherheitsrelevanter Vorgänge (Art. 32 DSGVO): wer hat wann was
// getan. Bewusst ohne Fremdschlüssel, damit Einträge das Löschen von Konten
// oder Patienten überdauern, und ohne Gesundheitsdaten: gespeichert werden
// nur Art des Vorgangs, betroffene Kennung und ein kurzer, neutraler Text.
model AuditLog {
  id         String   @id @default(cuid())
  practiceId String
  userId     String?
  userName   String?
  action     String
  entityType String?
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([practiceId, createdAt])
}

// Patientenakte: strukturierte Einträge statt Freitext, damit Allergien vor
// jedem Termin oben stehen und Diagnosen nach Code gesucht werden können.
// art: "ALLERGIE" | "DIAGNOSE" | "BEFUND" | "MEDIKATION" | "NOTIZ"
model PatientEntry {
  id          String    @id @default(cuid())
  practiceId  String
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  art         String
  text        String
  /// ICD-10-GM bei Diagnosen, optional
  code        String?
  datum       DateTime?
  /// Nicht mehr aktuell (z. B. abgeheilte Diagnose); bleibt für die Historie
  inaktiv     Boolean   @default(false)
  createdById String?
  createdBy   String?
  createdAt   DateTime  @default(now())

  @@index([practiceId, patientId])
}

// Dokumente zur Akte (Befunde von extern, Röntgen-PDF, Überweisungen).
// Für den Pilotbetrieb in der Datenbank; vor größeren Mengen in einen
// verschlüsselten Objektspeicher in der EU auslagern.
model PatientDocument {
  id          String   @id @default(cuid())
  practiceId  String
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name        String
  mime        String
  size        Int
  data        Bytes
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([practiceId, patientId])
}

// Standort einer Praxis (Hauptpraxis, Zweigpraxis). Behandlungsplätze und
// Sprechzeit pro Tag ergeben die Kapazität für die Auslastung.
model Location {
  id            String        @id @default(cuid())
  practiceId    String
  practice      Practice      @relation(fields: [practiceId], references: [id])
  name          String
  address       String?
  rooms         Int           @default(1)
  minutesPerDay Int           @default(480)
  createdAt     DateTime      @default(now())
  appointments  Appointment[]

  @@index([practiceId])
}

// Termin in Sorrida. Solange keine Terminschnittstelle zur Praxissoftware
// besteht, werden Termine hier eingetragen; sie werden nicht aus dem PVS
// gelesen. status: GEPLANT | BESTAETIGT | ERSCHIENEN | ABGESAGT | NICHT_ERSCHIENEN
model Appointment {
  id          String    @id @default(cuid())
  practiceId  String
  practice    Practice  @relation(fields: [practiceId], references: [id])
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  start       DateTime
  minutes     Int       @default(30)
  reason      String
  status      String    @default("GEPLANT")
  confirmedAt DateTime?
  remindedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([practiceId, start])
  @@index([patientId])
}
