# Datenbank (PostgreSQL - z. B. von Neon, Supabase oder Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="bitte-mit-`openssl rand -base64 32`-ersetzen"

# Anthropic (Claude) API-Key für die Berichtsgenerierung
ANTHROPIC_API_KEY=""
# Optional: Modell überschreiben (Standard: claude-sonnet-5)
ANTHROPIC_MODEL="claude-sonnet-5"

# Optional: E-Mail-Adresse, an die Anfragen aus dem Website-Formular gehen
# (zusätzlich zur Speicherung in der Datenbank, Tabelle "Lead").
LEAD_NOTIFY_EMAIL=""

# Registrierung neuer Praxen. Standard (leer oder nicht gesetzt): geschlossen.
# /register zeigt dann "Pilotplatz anfragen", POST /api/register antwortet mit 403.
# Nur mit dem Wert 1 ist die Registrierung offen, z. B. lokal für die Browser-Prüfungen.
# In Produktion erst setzen, wenn Nutzungsvertrag und AVV mit jeder Praxis geschlossen werden.
REGISTRIERUNG_OFFEN=""

# Absenderadresse für E-Mails (Resend). Ohne eigene Adresse verschickt Sorrida keine E-Mails an Patienten.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
