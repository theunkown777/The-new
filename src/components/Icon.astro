---
interface Props {
  name: 'charger' | 'keyboard' | 'smart-plug' | 'speaker' | 'powerbank';
}
const { name } = Astro.props;
---

{name === 'charger' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="6" width="13" height="13" rx="3" />
    <circle cx="9.5" cy="12.5" r="3.3" />
    <path d="M18 9l3-2v11l-3-2" />
  </svg>
)}

{name === 'keyboard' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2.5" y="6" width="19" height="12" rx="2" />
    <path d="M6 10h.01" />
    <path d="M10 10h.01" />
    <path d="M14 10h.01" />
    <path d="M18 10h.01" />
    <path d="M6 14h12" />
  </svg>
)}

{name === 'smart-plug' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="6" y="3" width="12" height="9" rx="2.5" />
    <path d="M9.5 6.5v2" />
    <path d="M14.5 6.5v2" />
    <path d="M9 12v3a3 3 0 0 0 6 0v-3" />
    <path d="M12 18v3" />
  </svg>
)}

{name === 'speaker' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="5" y="2.5" width="14" height="19" rx="3.5" />
    <circle cx="12" cy="8.2" r="2.1" />
    <circle cx="12" cy="15.3" r="3.4" />
  </svg>
)}

{name === 'powerbank' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="6" y="2.5" width="12" height="19" rx="2.5" />
    <path d="M13 6.5l-3.2 5H13l-3.2 5" />
  </svg>
)}
