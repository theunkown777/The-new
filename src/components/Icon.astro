---
interface Props {
  name: 'chair' | 'desk' | 'monitor-arm' | 'lamp' | 'headphones';
}
const { name } = Astro.props;
---

{name === 'chair' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 4h10l-1 7H8L7 4Z" />
    <path d="M6.5 11h11l1 4H5.5l1-4Z" />
    <path d="M7 15l-1.5 5" />
    <path d="M17 15l1.5 5" />
  </svg>
)}

{name === 'desk' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M2 8h20" />
    <path d="M2 8v2" />
    <path d="M22 8v2" />
    <path d="M5 10v9" />
    <path d="M19 10v9" />
  </svg>
)}

{name === 'monitor-arm' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="9" y="3" width="12" height="8" rx="1.2" />
    <path d="M5 21v-8" />
    <path d="M5 13c0-3 2-5 4-5" />
    <path d="M3 21h4" />
  </svg>
)}

{name === 'lamp' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M9 18h6" />
    <path d="M10 21h4" />
    <path d="M12 3a6 6 0 0 0-3 11.2c.6.4 1 1.1 1 1.8h4c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3Z" />
  </svg>
)}

{name === 'headphones' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 14v-2a8 8 0 0 1 16 0v2" />
    <rect x="3" y="14" width="4" height="6" rx="1.5" />
    <rect x="17" y="14" width="4" height="6" rx="1.5" />
  </svg>
)}
